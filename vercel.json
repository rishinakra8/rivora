{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/project/:id", "destination": "/frontend/project.html" },
    { "source": "/project", "destination": "/frontend/project.html" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/((?!api/).*)", "destination": "/frontend/$1" }
  ]
}
