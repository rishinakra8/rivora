# Server Port
PORT=5000

# SMTP Email Configuration
# Examples for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Email address where client enquiries should be delivered
CONTACT_RECEIVER_EMAIL=rishi.rivora@gmail.com

# Google Sheets Webhook URL (Optional — for live Google Sheets sync)
# Deploy backend/google-apps-script.js on your Google Sheet and paste URL below:
GOOGLE_SHEETS_WEBHOOK_URL=
